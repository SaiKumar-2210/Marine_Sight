# Copy to .env and add your own provider credentials. Never commit .env.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
# Optional: without this, the interface uses clearly labelled preview vessel positions.
AIS_STREAM_API_KEY=
# Optional CMEMS-compatible adapter endpoint returning JSON for ?lat=&lng=
CMEMS_WEATHER_URL=
