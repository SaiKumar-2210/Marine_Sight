# Copy to .env and fill in. Never commit .env.
# Copernicus Data Space Ecosystem (Sentinel-1/2 imagery via Sentinel Hub APIs)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# aisstream.io key — live AIS; the server takes one burst every 10 minutes
AIS_STREAM_API_KEY=
# Optional Kpler Maritime 2.0 token (probed at start; status shown at /api/ais/status)
KPLER_AIS_AUTH_TOKEN=

# Optional tuning
# PORT=3000
# PYTHON=python
# DAILY_SCAN_UTC_HOUR=3        # daily global scan of the previous UTC day
# AIS_BURST_SECONDS=90         # length of each 10-minute aisstream burst
# AIS_RETENTION_DAYS=30        # AIS track history kept for attribution
# SCHEDULER_DISABLED=1
# AIS_DISABLED=1
