{
  "name": "marinesight-incident-operations",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n \"server,vite\" -c \"cyan,magenta\" \"node server.js\" \"vite\"",
    "dev:vite": "vite",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test server/test/backend.test.js && cd ml_service && python -m pytest -q",
    "test:benchmark": "cd ml_service && python -m pytest -q -m benchmark -s",
    "test:e2e": "python scripts/e2e_qa.py",
    "train": "cd ml_service && python -m training.build_dataset && python -m training.train_unet && python -m training.train_verifier"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.5",
    "deck.gl-leaflet": "^1.3.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "sqlite3": "^6.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/types": "^7.29.8",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "vite": "^5.4.19"
  }
}
